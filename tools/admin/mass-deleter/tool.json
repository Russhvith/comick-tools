{
  "name": "Mass deleter",
  "summary": "Delete chapters or episodes in bulk, from a comic or from one user's uploads.",
  "scripts": [
    {
      "id": "delete",
      "file": "mass_delete.py",
      "title": "Delete chapters or episodes",
      "summary": "Anything left blank gets asked in the console. Deleting always needs DELETE typed in the console.",
      "needsCookie": true,
      "fields": [
        { "flag": "--slug", "type": "text", "label": "Comic or anime", "slugFrom": ["comic", "anime"], "placeholder": "Slug or ComicK link, empty when using a user" },
        { "flag": "--user", "type": "text", "label": "User id or profile link", "placeholder": "https://comick.dev/user/.../uploaded-chapters" },
        { "flag": "--type", "type": "select", "label": "What to delete", "options": ["chapter", "episode"] },
        { "flag": "--lang", "type": "text", "label": "Language", "placeholder": "en, or all" },
        { "flag": "--group", "type": "text", "label": "Only from group", "placeholder": "Comic chapters only" },
        { "flag": "--comic", "type": "text", "label": "Only from comic", "slugFrom": ["comic", "anime"], "placeholder": "User uploads only" },
        { "flag": "--select", "type": "text", "label": "Numbers", "placeholder": "1-10, 12.5 or all" },
        {
          "flag": "--reason",
          "type": "text",
          "label": "Reason",
          "multiline": true,
          "maxLength": 500,
          "appended": "Mass deleted by ComicK MassDeleter. (https://github.com/Russhvith/comick-tools)",
          "placeholder": "Why these are being deleted"
        },
        { "flag": "--dry-run", "type": "bool", "label": "Dry run, delete nothing", "hint": "Go through every check and list what would be deleted, without deleting anything." }
      ]
    }
  ],
  "files": []
}
