# Shared config for every tool in this repo.
# Copy to .env in the repo root and fill in. Never commit the real file.

# Value of the __Secure-comick-auth.session_token cookie from a logged in
# ComicK browser session. See docs/auth.md for how to grab it.
COMICK_SESSION_TOKEN=

# Most requests per second any tool sends to the ComicK API. Leave empty
# for the default of 5.
COMICK_UPLOADS_PER_SECOND=

# Where the ComicK API lives. Leave empty for https://api.comick.dev, only
# change it to test against a local server.
COMICK_API_BASE=
